<%- include('partials/header') %>
<main class="home-layout">
  <section class="home-copy">
    <p class="eyebrow">A small place for your next thing</p>
    <h1>Keep your account <em>anchored.</em></h1>
    <p class="lede">A clean, secure starting point for signing up, logging in, and getting back into your work.</p>
    <div class="home-actions"><a class="button button-primary" href="/signup">Create account</a><a class="button button-quiet" href="/login">I already have one</a></div>
  </section>
  <aside class="signal-card" aria-label="Security features">
    <div class="signal-orbit"></div><span class="signal-label">Your account, kept close</span>
    <div class="signal-line"><span class="signal-dot"></span><span>Private by default</span></div>
    <div class="signal-line"><span class="signal-dot"></span><span>Reset when you need it</span></div>
    <div class="signal-line"><span class="signal-dot"></span><span>Ready on any screen</span></div>
  </aside>
</main>
<%- include('partials/footer') %>
