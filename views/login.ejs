<%- include('partials/header') %>
<main class="auth-layout"><section class="auth-card"><p class="eyebrow">Welcome back</p><h1>Log in to anchor.</h1><p class="form-intro">Your work is waiting where you left it.</p><%- include('partials/alerts') %><form action="/login" method="post" class="auth-form"><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" value="<%= email || '' %>" required><label for="password">Password</label><input id="password" name="password" type="password" autocomplete="current-password" required><div class="form-row"><span></span><a href="/forgot-password">Forgot password?</a></div><button class="button button-primary button-full" type="submit">Log in</button></form><p class="form-footer">New here? <a href="/signup">Create an account</a></p></section></main>
<%- include('partials/footer') %>
